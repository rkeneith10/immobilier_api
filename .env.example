DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
API_NUM_PROXIES=0
SECURE_HSTS_SECONDS=31536000

DATABASE_NAME=immoplatform_users
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-with-your-local-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Comma-separated trusted frontend origins. Next.js development uses port 3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. When all values are set, media uploads use Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PROPERTY_IMAGE_MAX_UPLOAD_SIZE=10485760
PROFILE_IMAGE_MAX_UPLOAD_SIZE=5242880
